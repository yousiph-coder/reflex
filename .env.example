# ─────────────────────────────────────────────────────────────────
# Auto-Heal AI — Environment Variables
# Copy to .env and fill in real values before running.
# ─────────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────
APP_NAME=auto-heal-ai
APP_ENV=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# ── PostgreSQL (async driver) ───────────────────────────────────
DATABASE_URL=postgresql+asyncpg://autoheal:changeme@localhost:5432/autoheal
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
DEDUP_TTL_SECONDS=60

# ── Sentry Integration ─────────────────────────────────────────
SENTRY_CLIENT_SECRET=your-sentry-client-secret-here

# ── GitHub (PAT or GitHub App) ───────────────────────────────
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo
GITHUB_DEFAULT_BRANCH=main

# GitHub App Production Authentication (Recommended)
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here

# ── Alert Notification Channels (Optional) ────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXX
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/0000/XXXX

# ── LLM Provider ───────────────────────────────────────────────
LLM_API_KEY=sk-your-llm-api-key-here
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ── CORS ────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
